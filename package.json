{
  "name": "design-token-editor",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "build:hosted": "vite build --mode hosted",
    "build:worker": "wrangler deploy --dry-run",
    "deploy:public": "npm run build && wrangler deploy --config wrangler.public.jsonc",
    "deploy:sevan": "npm run build:hosted -- --outDir .wrangler/staging-assets && wrangler deploy --config wrangler.staging.jsonc",
    "preview": "vite preview",
    "test:browser": "playwright test",
    "typecheck": "tsc --noEmit",
    "lint": "node scripts/check-source.ts && oxlint --type-aware --deny-warnings --report-unused-disable-directives-severity=error",
    "check": "npm run typecheck && npm run lint && node --test tests/*.test.ts"
  },
  "dependencies": {
    "@tanstack/react-query": "^5.107.1",
    "@token-catalog/forge-react": "file:vendor/token-catalog-forge-react-0.3.18.tgz",
    "clsx": "^2.1.1",
    "colorjs.io": "0.7.1",
    "diff": "^9.0.0",
    "fflate": "0.8.3",
    "jose": "6.2.17",
    "jsonc-parser": "3.3.1",
    "lucide-react": "^1.72.0",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "tailwind-merge": "^3.7.0"
  },
  "devDependencies": {
    "@playwright/test": "1.65.0",
    "@tailwindcss/oxide": "^4.3.5",
    "@tailwindcss/vite": "^4.3.5",
    "@types/node": "^24.19.2",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.3.0",
    "oxlint": "^1.93.0",
    "oxlint-tsgolint": "^7.0.2006",
    "tailwindcss": "^4.3.5",
    "typescript": "^7.0.2",
    "vite": "8.3.5",
    "wrangler": "4.160.1"
  }
}
