{
  "name": "design-token-editor",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "build:hosted": "vite build --mode hosted",
    "build:worker": "wrangler deploy --dry-run",
    "preview": "vite preview",
    "typecheck": "tsc --noEmit",
    "lint": "node scripts/check-source.ts && oxlint --type-aware --deny-warnings --report-unused-disable-directives-severity=error",
    "check": "npm run typecheck && npm run lint && node --test tests/*.test.ts"
  },
  "dependencies": {
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "diff": "^9.0.0",
    "jose": "6.2.17",
    "jsonc-parser": "3.3.1",
    "lucide-react": "^1.72.0",
    "radix-ui": "^1.8.1",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "tailwind-merge": "^3.7.0",
    "tw-animate-css": "^1.4.0"
  },
  "devDependencies": {
    "@tailwindcss/vite": "^4.3.5",
    "@types/node": "^24.19.2",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.3.0",
    "oxlint": "^1.93.0",
    "oxlint-tsgolint": "^7.0.2006",
    "tailwindcss": "^4.3.5",
    "typescript": "^7.0.2",
    "vite": "8.3.5",
    "wrangler": "4.160.1"
  }
