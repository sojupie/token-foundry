{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "token-foundry-staging",
  "main": "worker/index.ts",
  "compatibility_date": "2026-11-01",
  "workers_dev": true,
  "preview_urls": true,
  "keep_vars": true,
  "assets": {
    "directory": "./.wrangler/staging-assets",
    "run_worker_first": ["/git/*"]
  }
}
