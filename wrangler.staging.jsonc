{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "token-foundry-staging",
  "main": "worker/index.ts",
  "compatibility_date": "2026-11-01",
  "workers_dev": false,
  "preview_urls": false,
  "keep_vars": true,
  "vars": {
    "EDITOR_ORIGIN": "https://sevan.tokenfoundry.lindstruct.com",
    "FIGMA_PLUGIN_ORIGIN": "https://token-foundry-figma-relay-staging.ollemarmenlind02.workers.dev"
  },
  "assets": {
    "directory": "./.wrangler/staging-assets",
    "not_found_handling": "single-page-application",
    "run_worker_first": ["/git/*", "/figma/workspaces/*", "/figma/pairing/*"]
  },
  "durable_objects": { "bindings": [{ "name": "WORKSPACES", "class_name": "SharedWorkspaceStore", "script_name": "token-foundry-figma-state-staging" },
    { "name": "WORKSPACE_INDEX", "class_name": "WorkspaceRegistry", "script_name": "token-foundry-figma-state-staging" }] }
}
